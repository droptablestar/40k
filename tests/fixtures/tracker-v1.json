{
  "_comment": "Characterises assets/js/tracker-state.js normalize() as hardened in the tracker-persistence slice. Classifications: 'valid' (input already conforms), 'tolerated-extension' (unknown properties preserved untouched), 'recovered' (a malformed round/cp/vp field is defaulted or coerced), 'reset' (an invalid armies container resets the whole game to blankGame()).",
  "storageKey": "benchtable:battle:v1",
  "probeKey": "benchtable:probe:v1",
  "cases": [
    {
      "name": "valid-v1-preserved",
      "classification": "valid",
      "input": {
        "round": 3,
        "active": 1,
        "armies": [
          { "name": "Josh", "cp": 4, "vp": 12 },
          { "name": "Sam", "cp": 2, "vp": 8 }
        ]
      },
      "expectedState": {
        "round": 3,
        "active": 1,
        "armies": [
          { "name": "Josh", "cp": 4, "vp": 12 },
          { "name": "Sam", "cp": 2, "vp": 8 }
        ]
      }
    },
    {
      "name": "unknown-properties-retained",
      "classification": "tolerated-extension",
      "input": {
        "round": 2,
        "active": 0,
        "note": "extra top-level field from a future version",
        "armies": [
          { "name": "Josh", "cp": 1, "vp": 0, "colour": "violet" },
          { "name": "Sam", "cp": 0, "vp": 0 }
        ]
      },
      "expectedState": {
        "round": 2,
        "active": 0,
        "note": "extra top-level field from a future version",
        "armies": [
          { "name": "Josh", "cp": 1, "vp": 0, "colour": "violet" },
          { "name": "Sam", "cp": 0, "vp": 0 }
        ]
      }
    },
    {
      "name": "round-non-numeric-string-recovers-to-default",
      "classification": "recovered",
      "input": {
        "round": "abc",
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "expectedState": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "note": "approved behaviour change 1: malformed round falls back to 1 instead of becoming NaN."
    },
    {
      "name": "round-fraction-rounds-to-nearest-integer",
      "classification": "recovered",
      "input": {
        "round": 3.7,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "expectedState": {
        "round": 4,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "note": "approved behaviour change 2: round is coerced to an integer in 1-5 (Math.round, then clamped)."
    },
    {
      "name": "round-numeric-string-recovers-to-default",
      "classification": "recovered",
      "input": {
        "round": "3",
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "expectedState": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "note": "approved behaviour change 4: numeric strings are treated as malformed rather than silently widening the schema."
    },
    {
      "name": "cp-negative-recovers-to-zero",
      "classification": "recovered",
      "input": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": -5, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "expectedState": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "note": "approved behaviour change 3: negative cp/vp fall back to 0."
    },
    {
      "name": "cp-numeric-string-recovers-to-zero",
      "classification": "recovered",
      "input": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": "12", "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "expectedState": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "note": "approved behaviour change 4: numeric strings are treated as malformed rather than silently widening the schema."
    },
    {
      "name": "armies-string-resets-to-blank-game",
      "classification": "reset",
      "input": {
        "round": 1,
        "active": 0,
        "armies": "ab"
      },
      "expectedState": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "note": "approved behaviour change 5: an invalid armies container resets to a blank game instead of throwing. Previously: saved.armies.length === 2 passed the guard and .forEach was not a function on a string, so the tracker rendered nothing."
    },
    {
      "name": "armies-null-entries-reset-to-blank-game",
      "classification": "reset",
      "input": {
        "round": 1,
        "active": 0,
        "armies": [null, null]
      },
      "expectedState": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "note": "approved behaviour change 5. Previously: strict mode threw reading .name off null inside the forEach callback."
    },
    {
      "name": "armies-non-object-entries-reset-to-blank-game",
      "classification": "reset",
      "input": {
        "round": 1,
        "active": 0,
        "armies": [1, 2]
      },
      "expectedState": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "note": "approved behaviour change 5. Previously: strict mode threw assigning a.name on a number inside the forEach callback."
    },
    {
      "name": "armies-array-like-object-resets-to-blank-game",
      "classification": "reset",
      "input": {
        "round": 1,
        "active": 0,
        "armies": { "length": 2 }
      },
      "expectedState": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "note": "approved behaviour change 5. Previously: length === 2 passed the guard, but a plain object has no .forEach, so it threw."
    },
    {
      "name": "armies-wrong-length-resets-to-blank-game",
      "classification": "reset",
      "input": {
        "round": 1,
        "active": 0,
        "armies": [null, null, null]
      },
      "expectedState": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "note": "an armies array of the wrong length resets to a blank game, both before and after this slice. The plan's ground-truth table also records `armies: [,,]` (a true sparse array of length 2) as not throwing and rendering a stray comma; JSON has no sparse-array literal, so this fixture cannot reproduce that exact input shape and it remains an untested gap."
    },
    {
      "name": "active-only-accepts-literal-1",
      "classification": "valid",
      "input": {
        "round": 1,
        "active": "1",
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "expectedState": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      }
    },
    {
      "name": "army-name-string-passes-through-untruncated",
      "classification": "valid",
      "input": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "A very long army name that is not truncated by normalisation at all", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "expectedState": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "A very long army name that is not truncated by normalisation at all", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      }
    },
    {
      "name": "invalid-json-survived",
      "classification": "reset",
      "rawStoredValue": "{not valid json",
      "expectedState": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "note": "store.read() catches the JSON.parse throw and returns null; normalize(null) falls back to blankGame()."
    },
    {
      "name": "missing-armies-resets-to-blank-game",
      "classification": "reset",
      "input": {
        "round": 4,
        "active": 1
      },
      "expectedState": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      }
    },
    {
      "name": "storage-unavailable-at-startup",
      "classification": "reset",
      "storageUnavailable": true,
      "expectedState": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 0, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "expectedUi": {
        "nostoreHidden": false,
        "savedText": "Session only"
      },
      "note": "the benchtable:probe:v1 probe throw sets store usable to false; load() then reads from the null in-memory store and falls back to blankGame()."
    },
    {
      "name": "write-failure-after-startup",
      "classification": "reset",
      "storageUnavailable": false,
      "writeThrowsAfterStartup": true,
      "input": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 1, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "expectedState": {
        "round": 1,
        "active": 0,
        "armies": [
          { "name": "Player one", "cp": 1, "vp": 0 },
          { "name": "Player two", "cp": 0, "vp": 0 }
        ]
      },
      "expectedUi": {
        "nostoreHidden": false,
        "savedText": "Session only"
      },
      "note": "approved behaviour change 6: when a write throws after startup (quota exceeded, storage revoked mid-session), the tracker keeps the latest state in memory, stops further localStorage writes for the page session, and shows the same 'Session only' warning used when the startup probe fails."
    }
  ]
}
