{
  "name": "40k",
  "version": "1.0.0",
  "description": "A plain-language Warhammer 40,000 (11th edition) and miniature painting reference for our group. Built with Eleventy.",
  "scripts": {
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "clean": "node scripts/clean-output.mjs",
    "check:source": "node scripts/check-layout.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:html": "node scripts/check-html.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:stratagems": "node scripts/check-stratagems.mjs",
    "check:datasheets": "node scripts/check-datasheets.mjs",
    "build": "npm run clean && npm run check:source && npm run check:stratagems && npm run check:datasheets && eleventy && npm run check:routes && npm run check:html && npm run check:links",
    "test:unit": "node --test tests/unit/**/*.test.mjs",
    "test:ui:functional": "playwright test --project=functional-mobile-chromium --project=functional-desktop-chromium",
    "test:ui:compat": "playwright test --project=compat-firefox --project=compat-webkit",
    "test:ui": "npm run test:ui:functional && npm run test:ui:compat",
    "test": "npm run test:unit && npm run test:ui",
    "serve": "npm run clean && npm run check:source && eleventy --serve"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/droptablestar/40k.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/droptablestar/40k/issues"
  },
  "homepage": "https://github.com/droptablestar/40k#readme",
  "engines": {
    "node": "26.0.0",
    "npm": "11.12.1"
  },
  "packageManager": "npm@11.12.1",
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@playwright/test": "1.62.1",
    "cheerio": "1.2.0",
    "html-validate": "11.7.0"
  }
}
