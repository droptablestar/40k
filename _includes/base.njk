{#- One nav entry: a link to a page, plus a flyout submenu of that page's
    sections if it declared any. The section list comes from the page's own
    `sections:` front matter — the same list its in-page jump nav is built
    from (see jump.njk), so the two cannot drift apart. Pages with no
    `sections:` (Charts, Tracker) render as a plain link. -#}
{% macro navitem(url, label, all) -%}
          <div class="nav-item-group">
            <a href="{{ url }}">{{ label }}</a>
            {%- for item in all %}{% if item.url == url and item.data.sections %}
            <div class="nav-subpanel">
              {%- for s in item.data.sections %}
              <a href="{{ url }}#{{ s.id }}">{{ s.label }}</a>
              {%- endfor %}
            </div>
            {%- endif %}{% endfor %}
          </div>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{% if themeColor %}<meta name="theme-color" content="{{ themeColor }}">
{% endif %}<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">
{% if pageCss %}<link rel="stylesheet" href="/assets/{{ pageCss }}">
{% endif %}</head>
<body class="{{ bodyClass }}">

<header class="sitebar">
  <div class="wrap">
    <a class="mark" href="/index.html">Bench <b>&amp;</b> Table</a>

    <div class="nav-drops">
      <details class="nav-drop">
        <summary{% if page.url.startsWith("/factions/") %} class="here"{% endif %}>Factions</summary>
        <div class="nav-panel">
          <div class="nav-item-group">
            <a href="/factions/tyranids.html">Tyranids</a>
            <div class="nav-subpanel">
              <a href="/factions/tyranids.html#identity">Identity</a>
              <a href="/factions/tyranids.html#painting">Painting log</a>
              <a href="/factions/tyranids.html#reference">Quick reference</a>
              <a href="/factions/tyranids/datasheets.html">Datasheets</a>
              <a href="/factions/tyranids/stratagems.html">Stratagems</a>
            </div>
          </div>
          <div class="nav-item-group">
            <a href="/factions/world-eaters.html">World Eaters</a>
            <div class="nav-subpanel">
              <a href="/factions/world-eaters.html#identity">Identity</a>
              <a href="/factions/world-eaters.html#painting">Painting log</a>
              <a href="/factions/world-eaters.html#reference">Quick reference</a>
              <a href="/factions/world-eaters/stratagems.html">Stratagems</a>
            </div>
          </div>
          <a class="nav-panel-more" href="/factions.html">Browse all factions &rarr;</a>
        </div>
      </details>
      <details class="nav-drop">
        <summary{% if page.url == "/painting.html" or page.url == "/painting-reference.html" or page.url == "/painting-table-ready.html" or page.url == "/troubleshooting.html" %} class="here"{% endif %}>Painting</summary>
        <div class="nav-panel">
          {{ navitem("/painting.html", "Painting, start to finish", collections.all) }}
          {{ navitem("/painting-reference.html", "Technique reference", collections.all) }}
          {{ navitem("/painting-table-ready.html", "Table-ready painting", collections.all) }}
          {{ navitem("/troubleshooting.html", "When it goes wrong", collections.all) }}
        </div>
      </details>
      <details class="nav-drop">
        <summary{% if page.url == "/turn-order.html" or page.url == "/charts.html" or page.url == "/keywords.html" or page.url == "/rules-changes.html" %} class="here"{% endif %}>Rules</summary>
        <div class="nav-panel">
          {{ navitem("/turn-order.html", "Turn order", collections.all) }}
          {{ navitem("/keywords.html", "Keywords & abilities", collections.all) }}
          {{ navitem("/charts.html", "Charts", collections.all) }}
          {{ navitem("/rules-changes.html", "What changed in 11th", collections.all) }}
        </div>
      </details>
    </div>

    <div class="sitenav-wrap">
      <nav class="sitenav" aria-label="Sections">
        <a href="/index.html"{% if page.url == "/" %} aria-current="page"{% endif %}>Start</a>
        <a href="/tracker.html"{% if page.url == "/tracker.html" %} aria-current="page"{% endif %}>Tracker</a>
      </nav>
    </div>
  </div>
</header>

<main>
  <div class="wrap">

    {{ content | safe }}

  </div>
</main>

<footer class="sitefoot">
  <div class="wrap">
    <p>Unofficial fan reference. Not affiliated with Games Workshop.</p>
    <p><a href="/references.html">References</a></p>
    {% if extraFooter %}{{ extraFooter | safe }}
    {% endif %}</div>
</footer>

<script src="/assets/js/sticky-offsets.js" defer></script>
<script src="/assets/js/nav.js" defer></script>
<script src="/assets/js/tips.js" defer></script>
<script src="/assets/js/heading-anchors.js" defer></script>
<script src="/assets/js/folds.js" defer></script>
{% if pageJs %}<script src="/assets/{{ pageJs }}" defer></script>
{% endif %}</body>
</html>
