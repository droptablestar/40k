{#- One nav entry: a link to a page, plus a flyout submenu of that page's
    sections if it declared any. The section list comes from the page's own
    `sections:` front matter — the same list its in-page jump nav is built
    from (see jump.njk), so the two cannot drift apart. Pages with no
    `sections:` (Charts, Tracker) render as a plain link. Items come from
    navGroupItems(), which reads each page's own navGroup/navLabel/navOrder
    front matter — no page URL is duplicated here. -#}
{% macro navGroupPanel(items) -%}
{%- for item in items %}
          <div class="nav-item-group">
            <a href="{{ item.url }}">{{ item.label }}</a>
            {%- if item.sections.length %}
            <div class="nav-subpanel">
              {%- for s in item.sections %}
              <a href="{{ item.url }}#{{ s.id }}">{{ s.label }}</a>
              {%- endfor %}
            </div>
            {%- endif %}
          </div>
{%- endfor %}
{%- endmacro %}

{#- Faction dropdown: one entry per _data/factions.js registry entry, joined
    against pages that declare a matching factionSlug. -#}
{% macro factionsPanel(groups, indexUrl) -%}
{%- for f in groups %}
          <div class="nav-item-group">
            <a href="{{ f.url }}">{{ f.name }}</a>
            <div class="nav-subpanel">
              {%- for s in f.sections %}
              <a href="{{ f.url }}#{{ s.id }}">{{ s.label }}</a>
              {%- endfor %}
              {%- if f.datasheetsUrl %}
              <a href="{{ f.datasheetsUrl }}">Datasheets</a>
              {%- endif %}
              {%- if f.stratagemsUrl %}
              <a href="{{ f.stratagemsUrl }}">Stratagems</a>
              {%- endif %}
              {%- if f.paintingUrl %}
              <a href="{{ f.paintingUrl }}">Painting log</a>
              {%- endif %}
            </div>
          </div>
{%- endfor %}
          <a class="nav-panel-more" href="{{ indexUrl }}">Browse all factions &rarr;</a>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{% if themeColor %}<meta name="theme-color" content="{{ themeColor }}">
{% endif %}<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">
{% if pageCss %}<link rel="stylesheet" href="/assets/{{ pageCss }}">
{% endif %}</head>
<body class="{{ bodyClass }}">

{% set topItems = navGroupItems(collections.all, "top") %}
<header class="sitebar">
  <div class="wrap">
    <a class="mark" href="{{ topItems[0].url }}">Bench <b>&amp;</b> Table</a>

    <div class="nav-drops">
      <details class="nav-drop">
        <summary{% if isFactionsActive(page.url, collections.all) %} class="here"{% endif %}>Factions</summary>
        <div class="nav-panel">
{{ factionsPanel(factionGroups(collections.all, factions), factionsIndexUrl(collections.all)) }}
        </div>
      </details>
      <details class="nav-drop">
        <summary{% if isGroupActive(page.url, collections.all, "painting") %} class="here"{% endif %}>Painting</summary>
        <div class="nav-panel">
{{ navGroupPanel(navGroupItems(collections.all, "painting")) }}
        </div>
      </details>
      <details class="nav-drop">
        <summary{% if isGroupActive(page.url, collections.all, "rules") %} class="here"{% endif %}>Rules</summary>
        <div class="nav-panel">
{{ navGroupPanel(navGroupItems(collections.all, "rules")) }}
        </div>
      </details>
    </div>

    <div class="sitenav-wrap">
      <nav class="sitenav" aria-label="Sections">
        {%- for item in topItems %}
        <a href="{{ item.url }}"{% if item.rawUrl == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endfor %}
      </nav>
    </div>
  </div>
</header>

<main>
  <div class="wrap">

    {{ content | safe }}

  </div>
</main>

<footer class="sitefoot">
  <div class="wrap">
    <p>Unofficial fan reference. Not affiliated with Games Workshop.</p>
    <p><a href="/references">References</a></p>
    {% if extraFooter %}{{ extraFooter | safe }}
    {% endif %}</div>
</footer>

<script src="/assets/js/sticky-offsets.js" defer></script>
<script src="/assets/js/nav.js" defer></script>
<script src="/assets/js/tips.js" defer></script>
<script src="/assets/js/heading-anchors.js" defer></script>
<script src="/assets/js/folds.js" defer></script>
{% if pageJs == "js/tracker.js" %}<script src="/assets/js/tracker-state.js" defer></script>
{% endif %}{% if pageJs %}<script src="/assets/{{ pageJs }}" defer></script>
{% endif %}</body>
</html>
