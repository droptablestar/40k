    <rect x="6" y="40" width="248" height="12" fill="var(--accent-solid)" opacity=".8"/>
    <rect x="6" y="24" width="248" height="16" fill="var(--bone)" opacity=".88"/>
    <g fill="var(--accent-solid)" opacity=".7">
      <path d="M46,40 C52,32 44,28 50,24 L62,24 C56,29 64,33 58,40 Z"/>
      <path d="M118,40 C124,31 116,29 122,24 L134,24 C128,30 136,33 130,40 Z"/>
      <path d="M190,40 C196,32 188,28 194,24 L206,24 C200,29 208,33 202,40 Z"/>
    </g>
    <g fill="none" stroke="var(--rust)" stroke-width="1.5">
      <path d="M84,38 L84,28"/><path d="M156,38 L156,28"/><path d="M228,38 L228,28"/>
    </g>
    <g fill="var(--rust)">
      <path d="M84,22 L79,32 L89,32 Z"/>
      <path d="M156,22 L151,32 L161,32 Z"/>
      <path d="M228,22 L223,32 L233,32 Z"/>
    </g>
    <rect x="6" y="24" width="248" height="44" fill="none" stroke="var(--line)"/>
    <text class="dia-t" x="6" y="18">NEW WET LAYER</text>
    <text class="dia-t" x="254" y="18" text-anchor="end">DRIED CONTRAST, LIFTING</text>
    <text class="dia-t" x="130" y="88" text-anchor="middle">PRIMER</text>
  </svg>
  <figcaption>Water in the new layer re-wets the dried film and carries its
